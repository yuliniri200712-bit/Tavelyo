# Copia este archivo como .env.local en la raíz del repositorio (git lo ignora) y ajusta los valores.
# La configuración web de Firebase no es secreta (llega al navegador), pero cambia por entorno.
# Nunca pongas aquí claves de servidor, de base de datos ni de la pasarela de pago.

# Proyecto de Firebase. Los proyectos «demo-*» solo funcionan con los emuladores locales.
VITE_FIREBASE_PROJECT_ID=demo-tavelyo
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-tavelyo.firebaseapp.com
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000

# true: Auth y SQL Connect se conectan a los emuladores locales (obligatorio con «demo-*»).
VITE_USE_EMULATORS=true

# Opcional: IP del equipo para probar desde un teléfono en la misma red (por defecto 127.0.0.1).
# VITE_EMULATOR_HOST=192.168.1.20
